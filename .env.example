# Copy to .env and fill in what you have. Every value is optional: ORBIT
# detects what is present and falls back to a built-in equivalent otherwise.

# ==============================================================================
# 1. FREE & FREE-TIER REASONING (LLM BACKENDS)
# ==============================================================================
# ORBIT prioritizes free and genuinely free-tier providers in `auto` mode.
# Without any key set, agents automatically use the built-in offline planner.
LLM_PROVIDER=auto              # auto | gemini | groq | xai | openrouter | openai_compatible | simulated

# --- Option A: Google Gemini (Generous free tier: up to 15 RPM / 1M TPM)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Option B: Groq (Free tier with ultra-low latency open models)
# Get a free key at https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Option C: xAI / Grok
# Get a key at https://console.x.ai/
XAI_API_KEY=
XAI_MODEL=grok-2-latest

# --- Option D: OpenRouter (Free tier models with :free tag)
# Get a key at https://openrouter.ai/
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# --- Option E: Local LLM / Custom OpenAI-Compatible (100% Free & Offline)
# e.g., Ollama (http://localhost:11434/v1), LM Studio, vLLM, LocalAI
OPENAI_BASE_URL=
# LOCAL_LLM_URL=http://localhost:11434/v1

# --- Optional / Legacy Paid Providers (Anthropic, OpenAI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4o-mini

# --- LLM Generation Parameters
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200

# ==============================================================================
# 2. WEB SEARCH & RETRIEVAL TOOLS
# ==============================================================================
# --- Tavily AI Search (Generous free tier: 1,000 free searches/month)
# Get a free key at https://tavily.com/
TAVILY_API_KEY=

# --- DuckDuckGo Web Search Fallback (Off by default for offline demo safety)
ALLOW_LIVE_WEB_SEARCH=false

# ==============================================================================
# 3. STRUCTURED STORE & SEMANTIC MEMORY
# ==============================================================================
# Leave blank to use built-in SQLite at data/orbit.db (Zero cost).
DATABASE_URL=
# DATABASE_URL=postgresql://orbit:orbit@localhost:5432/orbit

# Semantic memory collection & dimensions (uses zero-cost embedded vector index or local ChromaDB)
CHROMA_COLLECTION=orbit_memory
EMBEDDING_DIM=384
RETRIEVAL_TOP_K=4

# ==============================================================================
# 4. ASYNCHRONOUS EXECUTION & ESCALATION POLICY
# ==============================================================================
REDIS_URL=redis://localhost:6379/0
USE_CELERY=false               # true requires reachable Redis; false uses in-process threads

# Below this confidence, a human decides even for a low-risk action.
APPROVAL_CONFIDENCE_THRESHOLD=0.65
MAX_SUPERVISOR_HOPS=12
TOOL_TIMEOUT_SECONDS=20

# ==============================================================================
# 5. API SERVER & DATA DIRECTORY
# ==============================================================================
API_HOST=127.0.0.1
API_PORT=8000
# ORBIT_DATA_DIR=/var/lib/orbit
