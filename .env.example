# Copy to .env and fill in what you have. Every value is optional: ORBIT
# detects what is present and falls back to a built-in equivalent otherwise.

# --- reasoning ------------------------------------------------------------
# Without either key, agents use the offline planner and the UI labels every
# result as simulated.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4o-mini
LLM_PROVIDER=auto              # auto | anthropic | openai | simulated
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200

# --- structured store -----------------------------------------------------
# Leave blank to use SQLite at data/orbit.db.
DATABASE_URL=
# DATABASE_URL=postgresql://orbit:orbit@localhost:5432/orbit

# --- semantic memory ------------------------------------------------------
CHROMA_COLLECTION=orbit_memory
EMBEDDING_DIM=384
RETRIEVAL_TOP_K=4

# --- asynchronous execution ----------------------------------------------
REDIS_URL=redis://localhost:6379/0
USE_CELERY=false               # true also needs a reachable Redis

# --- escalation policy ----------------------------------------------------
# Below this confidence, a human decides even for a low-risk action.
APPROVAL_CONFIDENCE_THRESHOLD=0.65
MAX_SUPERVISOR_HOPS=12
TOOL_TIMEOUT_SECONDS=20
ALLOW_LIVE_WEB_SEARCH=false    # off by default so an offline lab never stalls

# --- api ------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# --- storage location -----------------------------------------------------
# ORBIT_DATA_DIR=/var/lib/orbit
